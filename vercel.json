{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/vercel-handler.js": {
      "includeFiles": "dist/server/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/vercel-handler?path=/$1",
      "methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS",
        "HEAD"
      ]
    },
    {
      "src": "/server/(.*)",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/__manus__/(.*)",
      "dest": "/public/__manus__/$1"
    },
    {
      "src": "/favicon(\\..*)?",
      "dest": "/public/favicon$1"
    },
    {
      "src": "/robots\\.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}