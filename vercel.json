{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(assets|images)/(.*)",
      "dest": "/dist/$1/$2"
    },
    {
      "src": "/robots.txt",
      "dest": "/dist/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/dist/sitemap.xml"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ]
}