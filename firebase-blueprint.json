{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer digital product orders for on-demand fulfillment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique order ID" },
        "orderNumber": { "type": "string", "description": "Human readable order number like ORD-12345" },
        "userId": { "type": "string", "description": "Customer ID or guest identifier" },
        "customerName": { "type": "string", "description": "Customer full name" },
        "customerEmail": { "type": "string", "description": "Customer email" },
        "customerPhone": { "type": "string", "description": "Customer WhatsApp phone number" },
        "items": { "type": "array", "description": "Ordered items" },
        "totalJOD": { "type": "number", "description": "Total order amount in JOD" },
        "totalUSD": { "type": "number", "description": "Total order amount in USD" },
        "paymentMethod": { "type": "string", "enum": ["cliq", "bank_transfer", "wallet"], "description": "Payment method chosen" },
        "paymentReference": { "type": "string", "description": "CliQ or Bank transfer transaction reference number" },
        "senderCliQAlias": { "type": "string", "description": "Customer CliQ alias or sender name" },
        "notes": { "type": "string", "description": "Customer notes or requests" },
        "status": { "type": "string", "enum": ["pending_payment", "payment_confirmed", "processing", "delivered", "completed", "cancelled"], "description": "Order lifecycle state" },
        "createdAt": { "type": "string", "description": "ISO timestamp of order creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "items", "totalJOD", "paymentMethod", "status", "createdAt"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "entity": "Order",
      "description": "Orders collection"
    }
  }
}
